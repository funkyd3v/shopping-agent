# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Env and secrets (never commit) ────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Databases (SQLite app DB + LangGraph checkpointer) ────────
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── Tests and coverage ────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Caches ────────────────────────────────────────────────────
.cache/
.turbo/
.npm/
.eslintcache.pytest_cache/
__pycache__/
*.pyc

# ── Editors and OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Debug ─────────────────────────────────────────────────────
*.pem
*.pid
*.seed
*.pid.lock
