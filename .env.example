# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_PROMPTS=false
# Server-side proxy target for Next.js rewrites (`/api/*` → NestJS).
API_ORIGIN=http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED. Fail fast if missing/weak. Generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=false

# ── LLM providers (set the ones you use) ──────────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_MODE=live                 # live | record | replay
PROVIDER_DISABLE=             # comma-separated provider ids (e.g. groq) for demos/tests
PROVIDER_DAILY_TOKEN_BUDGET=1000000

# ── Chroma / embeddings ───────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=store_policies
EMBEDDING_PROVIDER=gemini     # gemini | local (chosen once; no runtime fallback)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# RAG retrieval (cosine distance; lower is better). Calibrate with `pnpm eval:rag`.
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.38

# Read-only agent limits (agent.policy.ts defaults; env overrides)
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_ROUTER_MIN_CONFIDENCE=0.55

# ── Database ──────────────────────────────────────────────────
# Resolved relative to apps/api/ when the API runs.
DATABASE_URL=file:./data/app.db
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db

# ── Order/cart limits (guardrails.policy.ts defaults; env overrides) ──
MAX_ORDER_USD=200
MAX_QTY_PER_ITEM=5
MAX_AGENT_ORDERS_PER_DAY=5
MAX_AGENT_SPEND_PER_DAY_USD=500
CANCEL_WINDOW_MINUTES=30
MAX_CART_LINES=20

# ── Token budgets ─────────────────────────────────────────────
REQUEST_TOKEN_BUDGET=16000
SESSION_TOKEN_BUDGET=150000
DAILY_TOKEN_BUDGET=500000

# ── Guardrails (guardrails.policy.ts defaults; env overrides) ──
# Deterministic jailbreak pre-filter always runs. The opt-in live classifier
# uses the `guardrail` chain only for text in the gray zone.
JAILBREAK_THRESHOLD=0.8
REDUNDANCY_SIMILARITY_THRESHOLD=0.9
JAILBREAK_LIVE_CLASSIFIER=false

# ── Streaming/input ───────────────────────────────────────────
STREAM_MODE=buffered          # buffered (MVP); holdback is future work
MAX_MESSAGE_CHARS=2000
RUN_DEADLINE_MS=90000          # per-run wall-clock limit; friendly error on expiry

# ── Rate limits (requests/minute) ─────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_CART=60
RATE_LIMIT_CHECKOUT=10
