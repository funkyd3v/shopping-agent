{
  "name": "@shopping-agent/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "rag:ingest": "tsx scripts/rag-ingest.ts",
    "rag:ingest:reset": "tsx scripts/rag-ingest.ts --reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/google-genai": "2.3.7",
    "@langchain/groq": "1.3.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@shopping-agent/shared": "workspace:*",
    "argon2": "0.45.2",
    "chromadb": "3.5.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
